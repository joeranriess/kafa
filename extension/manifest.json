{
  "manifest_version": 3,
  "name": "Kleinanzeigen Anti Fraud Assistant",
  "version": "0.2.0",
  "description": "Analysiert Kleinanzeigen-Konversationen auf Betrugsrisiken und gibt klare Handlungsempfehlungen.",
  "homepage_url": "https://github.com/joeranriess/kafa",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.kleinanzeigen.de/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.kleinanzeigen.de/*nachrichten*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kleinanzeigen Anti Fraud Assistant"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
